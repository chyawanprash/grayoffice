{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ai-brand-visibility-template",
	"compatibility_date": "2025-10-08",
	"main": "./workers/app.ts",
	"upload_source_maps": true,
	"observability": {
		"enabled": true
	},
	"ai": {
		"binding": "AI",
		"remote": true
	},
	"kv_namespaces": [
		{
			"binding": "AEO_KV",
			"id": "623729d87586478981a14c15ddfe3764"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "grayoffice-db",
			"database_id": "e866ef68-dfbf-45b3-905b-ebcc4bb66f8f",
			"migrations_dir": "./migrations"
		}
	],
	"queues": {
		"producers": [
			{
				"queue": "brand-visibility-jobs",
				"binding": "BRAND_VISIBILITY_QUEUE"
			}
		],
		"consumers": [
			{
				"queue": "brand-visibility-jobs",
				"max_batch_size": 5,
				"max_concurrency": 10
			}
		]
	}
}
