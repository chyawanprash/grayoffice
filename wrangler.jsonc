{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "grayoffice-app",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./workers/app.ts",
	"upload_source_maps": true,
	"observability": {
		"enabled": true
	},
	// Non-secret vars. Secrets (SESSION_SECRET, GOOGLE_CLIENT_ID,
	// GOOGLE_CLIENT_SECRET, RESEND_API_KEY, PINECONE_API_KEY) are set with
	// `wrangler secret put`.
	"vars": {
		"APP_URL": "https://grayoffice.app",
		"RESEND_FROM": "hello@grayoffice.app",
		"BANK_URL": "https://bank.grayoffice.app",
		// Pinecone index name - created automatically on first use (dense, 768,
		// cosine, serverless aws/us-east-1). Only PINECONE_API_KEY is a secret.
		"PINECONE_INDEX": "grayoffice",
		// Finance agent model. OpenAI when OPENAI_API_KEY (secret) is set,
		// else Workers AI. Override the id here without a code change.
		"OPENAI_MODEL": "gpt-5.6-luna"
	},
	"ai": {
		"binding": "AI",
		"remote": true
	},
	"kv_namespaces": [
		{
			"binding": "AEO_KV",
			"id": "e0149b19ae504447933baacc2b672826"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "grayoffice-db",
			"database_id": "e866ef68-dfbf-45b3-905b-ebcc4bb66f8f",
			"migrations_dir": "./migrations"
		}
	],
	// Uploaded PDFs (Documents + knowledge base). Queue messages carry only the
	// R2 key - the bytes never go through a 128 KB queue message.
	"r2_buckets": [
		{
			"binding": "DOCS_BUCKET",
			"bucket_name": "grayoffice-docs"
		}
	],
	"queues": {
		"producers": [
			{
				"queue": "brand-visibility-jobs",
				"binding": "BRAND_VISIBILITY_QUEUE"
			},
			{
				"queue": "kb-ingest-jobs",
				"binding": "KB_QUEUE"
			}
		],
		"consumers": [
			{
				"queue": "brand-visibility-jobs",
				"max_batch_size": 5,
				"max_concurrency": 10
			},
			{
				"queue": "kb-ingest-jobs",
				"max_batch_size": 3,
				"max_concurrency": 4,
				"max_retries": 2
			}
		]
	}
}
